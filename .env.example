# Docker Compose defaults; .env is ignored by Git.
APP_PORT=8080
APP_ENV=development
REDIS_NAMESPACE=vocab-practice
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Leave empty for direct access. Behind a proxy, list only its actual IP/CIDRs.
# The proxy must overwrite or append the observed client to X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=40
# Host tools use REDIS_URL from the shell. They do not automatically load .env.
# REDIS_URL=redis://127.0.0.1:6379/0
# HTTP_ADDR=127.0.0.1:8080
# STATIC_DIR=../frontend/dist
# HTTPS deployment: APP_ENV=production and exact https:// origins; Secure cookies
# are then enforced. Compose deliberately uses HTTP development mode locally.

# Optional server-only AI. Blank key keeps the complete quiz usable.
# Learning controls require a valid key with Models read permission.
OPENAI_API_KEY=
OPENAI_TTS_ENABLED=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
AI_LEARNING_ENABLED=true
OPENAI_TEXT_MODEL=gpt-5.4-mini
# Single-operator local demo: use a random secret of at least 32 characters.
AI_AUTHORING_ENABLED=false
AUTHORING_ADMIN_SECRET=
